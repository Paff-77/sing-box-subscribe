      },
      {
        "type": "remote",
        "tag": "geosite-bilibili",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-bilibili.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-steam",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-steam.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-steam-cn",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-steam@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-onedrive",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-onedrive.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-cn.srs"
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geoip/raw/refs/heads/rule-set/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "inbound": [
          "tun-in",
          "mixed-in"
        ],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "clash_mode": "🚀 Rule",
        "action": "reject"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "clash_mode": "🌏 Global",
        "outbound": "🐟 FinalProxy"
      },
      {
        "clash_mode": "🎯 Direct",
        "outbound": "🎯 Direct"
      },
      {
        "clash_mode": "🌏 Global",
        "outbound": "🐟 FinalProxy"
      },
      {
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "outbound": "🎯 Direct"
      },
      {
        "ip_is_private": true,
        "outbound": "🎯 Direct"
      },
      {
        "network": "udp",
        "port": [
          443
        ],
        "rule_set": [
          "geosite-cn"
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": [
          443
        ],
        "rule_set": [
          "geoip-cn"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "AWAvenue-Ads"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-bilibili"
        ],
        "outbound": "📺 BiliBili"
      },
      {
        "rule_set": [
          "geosite-category-ai-chat-!cn"
        ],
        "outbound": "🤖 GlobalAI"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geosite-apple-cn"
        ],
        "outbound": "🍎 Apple"
      },
      {
        "ip_cidr": [
          "91.108.16.0/21",
          "91.108.56.0/23",
          "149.154.168.0/22",
          "2001:b28:f23c::/48",
          "2001:b28:f23f::/48"
