{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://gh.zakozako.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "🎯 Direct",
      "default_mode": "🚀 Rule"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "domain_resolver": "local"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "doh",
        "type": "https",
        "server": "cao.taniang.de",
        "path": "/bi",
        "domain_resolver": "local",
        "detour": "🚀 NodeSelect"
      },
      {
        "tag": "local",
        "type": "https",
        "server": "223.5.5.5",
        "path": "/dns-query"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "🎯 Direct",
        "action": "route",
        "server": "local"
      },
      {
        "clash_mode": "🌏 Global",
        "action": "route",
        "server": "doh"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "fakeip"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA",
              "HTTPS"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "doh",
        "client_subnet": "114.114.114.114/24"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA",
              "HTTPS"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          },
          {
            "rule_set": "geoip-cn",
            "match_response": true
          }
        ],
        "action": "respond"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7890
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.0/30",
        "fdfe:dcba:9876::0/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 NodeSelect",
      "outbounds": [
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "👋 ManualSelect",
      "outbounds": [
        "{all}"
      ]
    },
    {
      "tag": "🇭🇰 HongKong",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰|HK|hk|香港|港|HongKong"
          ]
        }
      ]
    },
    {
      "tag": "🇸🇬 Singapore",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬|SG|sg|新加坡|狮|Singapore"
          ]
        }
      ]
    },
    {
      "tag": "🇯🇵 Japan",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇯🇵|JP|jp|日本|日|Japan"
          ]
        }
      ]
    },
    {
      "tag": "🇺🇸 United States",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸|US|us|美国|美|United States"
          ]
        }
      ]
    },
    {
      "tag": "🌍 OtherRegions",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "🇭🇰|HK|hk|香港|香|🇹🇼|TW|tw|台湾|台|🇸🇬|SG|sg|新加坡|狮|🇯🇵|JP|jp|日本|日|🇺🇸|US|us|美国|美"
          ]
        }
      ]
    },
    {
      "type": "selector",
      "tag": "🤖 GlobalAI",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "🍎 Apple",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "✈️ TelegramDC5",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "✈️ TelegramDC1",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "✈️ TelegramDC4",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "📺 BiliBili",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "🎮 Steam",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "☁️ OneDrive",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "selector",
      "tag": "🐟 FinalProxy",
      "outbounds": [
        "🚀 NodeSelect",
        "🇭🇰 HongKong",
        "🇯🇵 Japan",
        "🇸🇬 Singapore",
        "🇺🇸 United States",
        "🌍 OtherRegions",
        "👋 ManualSelect",
        "✅ AutoSelect",
        "🎯 Direct"
      ]
    },
    {
      "type": "urltest",
      "tag": "✅ AutoSelect",
      "outbounds": [
        "{all}"
      ],
      "url": "https://cp.cloudflare.com",
      "interval": "5m",
      "tolerance": 2
    },
    {
      "type": "direct",
      "tag": "🎯 Direct"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "AWAvenue-Ads",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/Paff-77/sing-box-easylist/raw/refs/heads/output/AWAvenue-Ads-Rule.srs",
        "update_interval": "10m"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ai-chat-!cn",
        "format": "binary",
        "url": "https://gh.zakozako.com/https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-category-ai-chat-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple",
